<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="387dp"
        android:layout_height="276dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/flag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.10"
        app:srcCompat="@drawable/albanian" />

    <TextView
        android:id="@+id/overHint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:text="@string/hint"
        android:textAlignment="center"
        android:textColor="@color/red"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_min="wrap"
        tools:text="@string/hint" />

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@+id/overHint"
        app:layout_constraintStart_toStartOf="@+id/overHint"
        app:layout_constraintTop_toBottomOf="@+id/overHint">

        <Button
            android:id="@id/b5"
            android:layout_width="60sp"
            android:layout_height="60sp"
            android:layout_margin="20sp"
            android:layout_weight="1"
            android:background="@drawable/shapes"
            android:text="@string/b5" />

        <Button
            android:id="@id/b6"
            android:layout_width="60sp"
            android:layout_height="60sp"
            android:layout_margin="20sp"
            android:layout_weight="1"
            android:background="@drawable/shapes"
            android:text="@string/b6" />

        <Button
            android:id="@+id/b7"
            android:layout_width="60sp"
            android:layout_height="60sp"
            android:layout_margin="20sp"
            android:layout_weight="1"
            android:background="@drawable/shapes"
            android:text="@string/b7" />

        <Button
            android:id="@+id/b8"
            android:layout_width="60sp"
            android:layout_height="60sp"
            android:layout_margin="20sp"
            android:layout_weight="1"
            android:background="@drawable/shapes"
            android:text="@string/b8" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pair"
        android:onClick="pairWithDevice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.832" />




</androidx.constraintlayout.widget.ConstraintLayout>